rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /duoQuestRooms/{roomId} {
      // Requires anonymous sign-in; anyone who knows the room ID can read/write it.
      // Use a long, private room code. Do not store sensitive information here.
      allow read, write: if request.auth != null;
    }
  }
}
